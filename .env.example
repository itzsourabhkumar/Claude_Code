# Claude Code Token Usage Tracker - optional environment overrides
#
# NOT REQUIRED. Everything here has a working default in config.json, and the
# tracker never reads a .env file automatically - these are ordinary environment
# variables. This file documents them and gives you something to copy:
#
#   Windows (PowerShell)   $env:CCTRACKER_PORT = "9000"
#   Windows (CMD)          set CCTRACKER_PORT=9000
#   Linux / macOS          export CCTRACKER_PORT=9000
#
# Or, if you prefer a file, copy it and source it in your own shell profile:
#
#   cp .env.example .env      # .env is gitignored and is yours alone
#
# THERE ARE NO SECRETS HERE, AND THERE MUST NEVER BE ANY. The tracker has no
# API keys, no tokens and no credentials: it reads Claude Code's own local
# transcripts and makes no network calls at all. Never put a credential in this
# file or in config.json.


# --------------------------------------------------------------------------
# Locations
# --------------------------------------------------------------------------
# Repository root. Also what relative paths in config.json resolve against.
# Set this to run two independent installations from one checkout.
#CCTRACKER_ROOT=/home/you/claude-token-tracker

# Use a config file other than <root>/config.json.
#CCTRACKER_CONFIG=/home/you/claude-tracker.config.json

# Where collected usage, per-session state and the SQLite index are written.
# Overrides paths.data_dir (and the three keys under it) in config.json.
#CCTRACKER_DATA_DIR=/var/lib/cctracker/data
#CCTRACKER_DATA_DIR=D:/ClaudeUsage/data

# Where tracker.log and server.log are written.
#CCTRACKER_LOGS_DIR=/var/log/cctracker


# --------------------------------------------------------------------------
# Dashboard
# --------------------------------------------------------------------------
# Bind address. Must be a loopback address (127.0.0.1, ::1 or localhost);
# anything reachable from the network is refused, because the dashboard serves
# your prompt text and has no authentication.
#CCTRACKER_HOST=127.0.0.1

# Port to listen on.
#CCTRACKER_PORT=8765

# Set to 1 to stop the dashboard opening a browser window (useful over SSH,
# in a container, or on a headless machine).
#CCTRACKER_NO_BROWSER=1


# --------------------------------------------------------------------------
# Behaviour
# --------------------------------------------------------------------------
# Timezone used to bucket interactions into calendar days. "local" follows the
# machine. A fixed offset works on every platform with no extra packages; an
# IANA name needs a timezone database, which Linux and macOS ship and Windows
# gets from "pip install tzdata".
#CCTRACKER_TIMEZONE=local
#CCTRACKER_TIMEZONE=+05:30
#CCTRACKER_TIMEZONE=Asia/Kolkata


# --------------------------------------------------------------------------
# Cost reporting
# --------------------------------------------------------------------------
# USD -> INR rate used for every rupee figure on the dashboard, in the CLI and
# in generated reports. Overrides pricing.usd_to_inr in config.json.
#
# It is static on purpose: the tracker makes no network calls, and a rate that
# moved on its own would make the same data report a different figure every day.
# Set it to whatever rate you account at. Costs are always derived from the
# stored token counts, so changing this corrects historical figures too.
#CCTRACKER_USD_TO_INR=88.0


# --------------------------------------------------------------------------
# Claude Code (read by Claude Code itself, not by this tracker)
# --------------------------------------------------------------------------
# If you have moved Claude Code's configuration directory, the tracker follows
# it automatically on all three operating systems.
#CLAUDE_CONFIG_DIR=/home/you/.claude
